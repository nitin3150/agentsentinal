# ── Primary LLM (required) ───────────────────────────────────────────────────
# Set LLM_MODEL to any litellm-compatible model string.
# Format: <provider>/<model-name>
# Examples:
#   groq/llama-3.3-70b-versatile
#   openrouter/anthropic/claude-3-5-sonnet
#   openai/gpt-4o
#   anthropic/claude-sonnet-4-6
#   ollama/llama3
LLM_MODEL=groq/llama-3.3-70b-versatile

# API key for your chosen provider.
# litellm auto-selects the right env var based on the provider prefix,
# so you can also set the provider-specific key instead:
#   GROQ_API_KEY, OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
LLM_API_KEY=

# ── Optional per-provider overrides ──────────────────────────────────────────
# Only needed if you want to override keys per-provider.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=

# ── Timeouts (optional) ───────────────────────────────────────────────────────
# LLM_TIMEOUT=30
# POLICY_TIMEOUT=30
# SEMANTIC_TIMEOUT=30
# COMPLIANCE_TIMEOUT=30

# ── Behaviour flags (optional) ────────────────────────────────────────────────
# Log full system prompts during inspection (off by default — avoid in production).
# AGENTSENTINEL_LOG_PROMPTS=false

# Safe mode: disables dynamic file imports in the filepath detector.
# Enable in production or untrusted environments.
# AGENTSENTINEL_SAFE_MODE=true
