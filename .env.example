# Primary model selection. The code accepts these in order:
# LLM_MODEL, GROQ_MODEL, OPENROUTER_MODEL, NVIDIA_MODEL.
LLM_MODEL=groq/llama-3.3-70b-versatile

# Optional provider API key overrides. Set only the one you use.
LLM_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Optional provider base URLs. Set only if you need to override defaults.
LLM_BASE_URL=
GROQ_BASE_URL=
OPENROUTER_BASE_URL=
NVIDIA_BASE_URL=

# Optional provider-specific model overrides.
GROQ_MODEL=
OPENROUTER_MODEL=
NVIDIA_MODEL=

# Timeouts in seconds.
LLM_TIMEOUT=30
POLICY_TIMEOUT=30
SEMANTIC_TIMEOUT=30
COMPLIANCE_TIMEOUT=30

# Behaviour flags.
AGENTSENTINEL_LOG_PROMPTS=false
AGENTSENTINEL_SAFE_MODE=true
